@startuml
title <size:24>Deployment View: EcoRecicla AQP - Producción</size>\n<size:24>Despliegue en producción (MVP): un solo servidor en la nube.</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Deployment>

Deployment_Node(Producción.Dispositivodelusuario, "Dispositivo del usuario", $type="Android / navegador web", $descr="Celular o PC de vecinos y recicladores", $tags="", $link="") {
  Container(Producción.Dispositivodelusuario.AppVecino_1, "App Vecino", $techn="PWA / React", $descr="Interfaz web progresiva para reportar reciclaje.", $tags="", $link="")
  Container(Producción.Dispositivodelusuario.AppReciclador_1, "App Reciclador", $techn="PWA / React", $descr="Interfaz web progresiva para gestionar rutas.", $tags="", $link="")
}

Deployment_Node(Producción.Servidorenlanube, "Servidor en la nube", $type="Ubuntu Server LTS", $descr="Un solo servidor, sin alta disponibilidad (ADR-001); tamaño por cotizar (R-03)", $tags="", $link="") {
  Deployment_Node(Producción.Servidorenlanube.Nginx, "Nginx", $type="Nginx", $descr="Proxy inverso y terminación HTTPS", $tags="", $link="")
  Deployment_Node(Producción.Servidorenlanube.Entornodeejecución, "Entorno de ejecución", $type="Node.js", $descr="", $tags="", $link="") {
    Container(Producción.Servidorenlanube.Entornodeejecución.APIREST_1, "API REST", $techn="Node.js / Express", $descr="Monolito modular que gestiona todo el dominio del sistema.", $tags="", $link="")
    Container(Producción.Servidorenlanube.Entornodeejecución.OptimizadordeRutas_1, "Optimizador de Rutas", $techn="Node.js Cron", $descr="Tarea asíncrona para calcular la mejor ruta.", $tags="", $link="")
  }

  Deployment_Node(Producción.Servidorenlanube.Motordebasededatos, "Motor de base de datos", $type="PostgreSQL", $descr="", $tags="", $link="") {
    ContainerDb(Producción.Servidorenlanube.Motordebasededatos.BasedeDatos_1, "Base de Datos", $techn="PostgreSQL", $descr="Almacena usuarios, solicitudes, puntos y rutas.", $tags="", $link="")
  }

}

Rel(Producción.Dispositivodelusuario.AppVecino_1, Producción.Servidorenlanube.Entornodeejecución.APIREST_1, "Inicia sesión", $techn="HTTPS/JSON", $tags="", $link="")
Rel(Producción.Dispositivodelusuario.AppReciclador_1, Producción.Servidorenlanube.Entornodeejecución.APIREST_1, "Inicia sesión", $techn="HTTPS/JSON", $tags="", $link="")
Rel(Producción.Servidorenlanube.Entornodeejecución.APIREST_1, Producción.Servidorenlanube.Motordebasededatos.BasedeDatos_1, "Lee", $techn="SQL/TCP", $tags="", $link="")
Rel(Producción.Servidorenlanube.Entornodeejecución.OptimizadordeRutas_1, Producción.Servidorenlanube.Motordebasededatos.BasedeDatos_1, "Lee solicitudes y actualiza rutas", $techn="SQL/TCP", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml